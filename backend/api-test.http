### 1. Register new user
POST https://galore.onrender.com/api/auth/register
Content-Type: application/json

{
  "email": "test_irma@example.com",
  "password": "test123",
  "name": "Test User"
}

###

### 2. Login user
POST https://galore.onrender.com/api/auth/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "test123"
}

###

### 3. Create artist profile 
POST https://galore.onrender.com/api/artworks/artist
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6ImZkMDdhY2MyLTFhMGMtNDUzYy05ZTkxLTYzMjJlZjUzZDM3MyIsImVtYWlsIjoidGVzdHVzZXJAZXhhbXBsZS5jb20iLCJyb2xlIjoiVVNFUiIsImlhdCI6MTc4MDg0Nzc2NSwiZXhwIjoxNzgwODUxMzY1fQ.2AYYxcQDd_YeTjrKFjcVGlu-YyBLhZHDl8h5s-D23QM
Content-Type: application/json

{
  "bio": "Digital painter",
  "website": "https://artist-portfolio.com"
}

###

### 4. Add artwork
POST https://galore.onrender.com/api/artworks
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6ImZkMDdhY2MyLTFhMGMtNDUzYy05ZTkxLTYzMjJlZjUzZDM3MyIsImVtYWlsIjoidGVzdHVzZXJAZXhhbXBsZS5jb20iLCJyb2xlIjoiVVNFUiIsImlhdCI6MTc4MDg0Nzc2NSwiZXhwIjoxNzgwODUxMzY1fQ.2AYYxcQDd_YeTjrKFjcVGlu-YyBLhZHDl8h5s-D23QM
Content-Type: application/json

{
  "title": "Forest Light",
  "description": "Oil on canvas",
  "imageUrl": "https://example.com/forest.jpg",
  "price": 200
}

